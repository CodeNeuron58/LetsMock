# Copy to .env and fill in. GROQ + DEEPGRAM keys are always required.
# console mode runs locally (mic/speaker) but still needs the LIVEKIT_* vars
# set to *something* — dummy dev values are fine; it never actually connects.

# --- Model providers (required, including console mode) ---
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# --- LiveKit: dummy dev values work for console; use REAL LiveKit Cloud
#     values once the phone connects. ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_console_only_000000000000

# --- Optional: premium TTS for the Pro tier (wired later) ---
# ELEVENLABS_API_KEY=
