---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** The home page floats the nav over its dark hero; every other page is light. */
  dark?: boolean;
}

const { title, description, dark = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { href: "/how-it-works", label: "How it works" },
  { href: "/scorecard", label: "Scorecard" },
  { href: "/pricing", label: "Pricing" },
  { href: "/faq", label: "FAQ" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={dark ? "#0B0A12" : "#ffffff"} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='9' fill='%236C4BFF'/></svg>"
    />
  </head>

  <body class="bg-white font-sans text-ink-880 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[70] focus:rounded-full focus:bg-violet-500 focus:px-5 focus:py-2.5 focus:text-white"
      >Skip to content</a
    >

    <div
      class:list={[
        "sticky top-0 z-60 px-4 pt-4 sm:px-[18px]",
        !dark && "bg-linear-to-b from-white from-60% to-transparent",
      ]}
    >
      <nav
        class:list={[
          "mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-4 rounded-full border py-[9px] pr-[9px] pl-[22px] backdrop-blur-[18px]",
          dark
            ? "border-white/12 bg-white/7"
            : "border-paper-400 bg-white/82 shadow-[0_8px_24px_-18px_rgba(20,18,28,0.4)]",
        ]}
      >
        <a
          href="/"
          class:list={[
            "flex items-center gap-[9px]",
            dark ? "text-mist-50" : "text-ink-880",
          ]}
        >
          <span
            class="size-[9px] rounded-full bg-violet-500 shadow-[0_0_0_4px_rgba(108,75,255,0.22)]"
          ></span>
          <span class="text-[17.5px] font-bold tracking-[-0.03em]">LetsMock</span>
        </a>

        <div class="flex flex-wrap items-center gap-1.5">
          {
            nav.map(({ href, label }) => {
              const active = path === href;
              return (
                <a
                  href={href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "rounded-full px-3.5 py-2 text-sm transition-colors",
                    active
                      ? dark
                        ? "bg-white/12 font-semibold text-white"
                        : "bg-paper-200 font-semibold text-ink-880"
                      : dark
                        ? "font-medium text-mist-200 hover:bg-white/7 hover:text-white"
                        : "font-medium text-slate-600 hover:bg-paper-150 hover:text-ink-880",
                  ]}
                >
                  {label}
                </a>
              );
            })
          }
          <a
            href="/#waitlist"
            class:list={[
              "ml-1.5 rounded-full px-5 py-[11px] text-sm font-semibold transition-colors",
              dark
                ? "bg-white text-ink-880 hover:bg-violet-500 hover:text-white"
                : "bg-ink-880 text-white hover:bg-violet-500",
            ]}
          >
            Get early access
          </a>
        </div>
      </nav>
    </div>

    <main id="main"><slot /></main>

    <footer class="border-t border-ink-550 bg-ink-950 text-mist-50">
      <div
        class="mx-auto grid max-w-[1180px] grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-9 px-6 py-14"
      >
        <div>
          <div class="mb-3 flex items-center gap-[9px]">
            <span class="size-[9px] rounded-full bg-violet-500"></span>
            <span class="text-[17.5px] font-bold tracking-[-0.03em]">LetsMock</span>
          </div>
          <p class="max-w-[22em] text-sm leading-[1.55] text-mist-500">
            Voice mock interviews with a scorecard that doesn't flatter you.
          </p>
        </div>

        <div class="flex flex-col gap-[11px]">
          <div class="label text-[9.5px] text-mist-700">Product</div>
          <a href="/how-it-works" class="text-[14.5px] text-mist-200 hover:text-white"
            >How it works</a
          >
          <a href="/scorecard" class="text-[14.5px] text-mist-200 hover:text-white"
            >The scorecard</a
          >
          <a href="/pricing" class="text-[14.5px] text-mist-200 hover:text-white">Pricing</a>
        </div>

        <div class="flex flex-col gap-[11px]">
          <div class="label text-[9.5px] text-mist-700">Support</div>
          <a href="/faq" class="text-[14.5px] text-mist-200 hover:text-white">FAQ</a>
          <a
            href="mailto:hello@letsmock.com"
            class="text-[14.5px] text-mist-200 hover:text-white">hello@letsmock.com</a
          >
          <a href="/privacy" class="text-[14.5px] text-mist-200 hover:text-white">Privacy</a>
          <a href="/terms" class="text-[14.5px] text-mist-200 hover:text-white">Terms</a>
        </div>

        <div class="flex flex-col gap-[11px]">
          <div class="label text-[9.5px] text-mist-700">Status</div>
          <span class="text-[14.5px] text-mist-200">Closed beta, Android</span>
          <span class="text-[14.5px] text-mist-700"
            >© {new Date().getFullYear()} LetsMock</span
          >
        </div>
      </div>
    </footer>
  </body>
</html>
